# Raw and processed data must never be committed.
data/raw/
data/processed/
*.duckdb
*.duckdb.wal

# Generated logs and local caches.
logs/*.json
logs/*.log
__pycache__/
.pytest_cache/
pytest-cache-files-*/
.test_runtime/
.streamlit/secrets.toml
.venv/

# Office temporary files.
~$*.docx
~$*.xlsx
.test_tmp/
